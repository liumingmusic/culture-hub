{
  "道德经": [
    {
      "id": "ddj-25",
      "text": "人法地，地法天，天法道，道法自然。",
      "ref": "第二十五章"
    },
    {
      "id": "ddj-1",
      "text": "道可道，非常道；名可名，非常名。",
      "ref": "第一章"
    },
    {
      "id": "ddj-8",
      "text": "上善若水。水善利万物而不争，处众人之所恶，故几于道。",
      "ref": "第八章"
    },
    {
      "id": "ddj-22",
      "text": "曲则全，枉则直，洼则盈，敝则新，少则得，多则惑。",
      "ref": "第二十二章"
    },
    {
      "id": "ddj-33",
      "text": "知人者智，自知者明。胜人者有力，自胜者强。",
      "ref": "第三十三章"
    },
    {
      "id": "ddj-64",
      "text": "合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。",
      "ref": "第六十四章"
    }
  ],
  "论语": [
    {
      "id": "lunyu-1",
      "text": "学而时习之，不亦说乎？有朋自远方来，不亦乐乎？",
      "ref": "学而"
    },
    {
      "id": "lunyu-12",
      "text": "己所不欲，勿施于人。",
      "ref": "卫灵公"
    },
    {
      "id": "lunyu-16",
      "text": "学而不思则罔，思而不学则殆。",
      "ref": "为政"
    },
    {
      "id": "lunyu-20",
      "text": "君子务本，本立而道生。孝弟也者，其为仁之本与！",
      "ref": "学而"
    },
    {
      "id": "lunyu-7",
      "text": "三人行，必有我师焉。择其善者而从之，其不善者而改之。",
      "ref": "述而"
    },
    {
      "id": "lunyu-14",
      "text": "温故而知新，可以为师矣。",
      "ref": "为政"
    },
    {
      "id": "lunyu-3",
      "text": "吾日三省吾身：为人谋而不忠乎？与朋友交而不信乎？传不习乎？",
      "ref": "学而"
    },
    {
      "id": "lunyu-4",
      "text": "克己复礼为仁。一日克己复礼，天下归仁焉。",
      "ref": "颜渊"
    },
    {
      "id": "lunyu-5",
      "text": "知之者不如好之者，好之者不如乐之者。",
      "ref": "雍也"
    },
    {
      "id": "lunyu-6",
      "text": "士不可以不弘毅，任重而道远。",
      "ref": "泰伯"
    },
    {
      "id": "lunyu-7",
      "text": "郁郁乎文哉，吾从周。",
      "ref": "八佾"
    }
  ],
  "诗经": [
    {
      "id": "shijing-07",
      "text": "七月流火，九月授衣。",
      "ref": "豳风·七月"
    },
    {
      "id": "shijing-qin",
      "text": "窈窕淑女，琴瑟友之。窈窕淑女，钟鼓乐之。",
      "ref": "周南·关雎"
    },
    {
      "id": "shijing-01",
      "text": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。",
      "ref": "周南·关雎"
    },
    {
      "id": "shijing-tao",
      "text": "投我以木桃，报之以琼瑶。匪报也，永以为好也。",
      "ref": "卫风·木瓜"
    },
    {
      "id": "shijing-caoxu",
      "text": "蒹葭苍苍，白露为霜。所谓伊人，在水一方。",
      "ref": "秦风·蒹葭"
    },
    {
      "id": "shijing-xiaoya",
      "text": "高山仰止，景行行止。虽不能至，心向往之。",
      "ref": "小雅·车舝"
    }
  ],
  "楚辞": [
    {
      "id": "chuci-01",
      "text": "路漫漫其修远兮，吾将上下而求索。",
      "ref": "离骚"
    },
    {
      "id": "chuci-02",
      "text": "亦余心之所善兮，虽九死其犹未悔。",
      "ref": "离骚"
    },
    {
      "id": "chuci-03",
      "text": "袅袅兮秋风，洞庭波兮木叶下。",
      "ref": "九歌·湘夫人"
    },
    {
      "id": "chuci-04",
      "text": "朝饮木兰之坠露兮，夕餐秋菊之落英。",
      "ref": "离骚"
    },
    {
      "id": "chuci-05",
      "text": "长太息以掩涕兮，哀民生之多艰。",
      "ref": "离骚"
    }
  ],
  "四书章句": [
    {
      "id": "sishu-1",
      "text": "大学之道，在明明德，在亲民，在止于至善。",
      "ref": "大学"
    },
    {
      "id": "sishu-2",
      "text": "富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。",
      "ref": "孟子·滕文公下"
    },
    {
      "id": "sishu-3",
      "text": "天时不如地利，地利不如人和。",
      "ref": "孟子·公孙丑下"
    },
    {
      "id": "sishu-4",
      "text": "恻隐之心，仁之端也；羞恶之心，义之端也。",
      "ref": "孟子·公孙丑上"
    }
  ],
  "中庸": [
    {
      "id": "zy-1",
      "text": "天命之谓性，率性之谓道，修道之谓教。",
      "ref": "第一章"
    },
    {
      "id": "zy-2",
      "text": "喜怒哀乐之未发谓之中，发而皆中节谓之和。",
      "ref": "第一章"
    },
    {
      "id": "zy-3",
      "text": "博学之，审问之，慎思之，明辨之，笃行之。",
      "ref": "第二十章"
    }
  ],
  "千字文": [
    {
      "id": "qz-1",
      "text": "天地玄黄，宇宙洪荒。日月盈昃，辰宿列张。",
      "ref": "开篇"
    },
    {
      "id": "qz-2",
      "text": "寒来暑往，秋收冬藏。闰余成岁，律吕调阳。",
      "ref": "时令"
    }
  ],
  "朱子家训": [
    {
      "id": "zz-1",
      "text": "黎明即起，洒扫庭除，要内外整洁。",
      "ref": "开篇"
    },
    {
      "id": "zz-2",
      "text": "一粥一饭，当思来处不易；半丝半缕，恒念物力维艰。",
      "ref": "勤俭"
    },
    {
      "id": "zz-3",
      "text": "宜未雨而绸缪，毋临渴而掘井。",
      "ref": "谋虑"
    }
  ],
  "三字经": [
    {
      "id": "sze-1",
      "text": "人之初，性本善。性相近，习相远。",
      "ref": "开篇"
    },
    {
      "id": "sze-2",
      "text": "玉不琢，不成器。人不学，不知义。",
      "ref": "劝学"
    }
  ],
  "易经": [
    {
      "id": "yj-1",
      "text": "天行健，君子以自强不息。地势坤，君子以厚德载物。",
      "ref": "乾·象传 / 坤·象传"
    },
    {
      "id": "yj-2",
      "text": "二人同心，其利断金；同心之言，其臭如兰。",
      "ref": "系辞上"
    },
    {
      "id": "yj-3",
      "text": "穷则变，变则通，通则久。",
      "ref": "系辞下"
    },
    {
      "id": "yj-4",
      "text": "一阴一阳之谓道。",
      "ref": "系辞上"
    }
  ],
  "六祖坛经": [
    {
      "id": "zc-1",
      "text": "菩提本无树，明镜亦非台。本来无一物，何处惹尘埃。",
      "ref": "行由品"
    },
    {
      "id": "zc-2",
      "text": "菩提只向心觅，何劳向外求玄。",
      "ref": "疑问品"
    }
  ],
  "庄子": [
    {
      "id": "zhuangzi-1",
      "text": "北冥有鱼，其名为鲲。鲲之大，不知其几千里也。",
      "ref": "逍遥游"
    },
    {
      "id": "zhuangzi-2",
      "text": "天地与我并生，而万物与我为一。",
      "ref": "齐物论"
    },
    {
      "id": "zhuangzi-3",
      "text": "吾生也有涯，而知也无涯。",
      "ref": "养生主"
    },
    {
      "id": "zhuangzi-4",
      "text": "泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。",
      "ref": "大宗师"
    },
    {
      "id": "zhuangzi-5",
      "text": "人皆知有用之用，而莫知无用之用也。",
      "ref": "人间世"
    }
  ],
  "礼记": [
    {
      "id": "liji-1",
      "text": "大道之行也，天下为公。选贤与能，讲信修睦。",
      "ref": "礼运"
    },
    {
      "id": "liji-2",
      "text": "礼尚往来。往而不来，非礼也；来而不往，亦非礼也。",
      "ref": "曲礼上"
    },
    {
      "id": "liji-3",
      "text": "凡为人子之礼，冬温而夏凊，昏定而晨省。",
      "ref": "曲礼上"
    },
    {
      "id": "liji-4",
      "text": "玉不琢，不成器；人不学，不知道。是故古之王者，建国君民，教学为先。",
      "ref": "学记"
    }
  ],
  "弟子规": [
    {
      "id": "dzg-1",
      "text": "冬则温，夏则凊；晨则省，昏则定。",
      "ref": "入则孝"
    },
    {
      "id": "dzg-2",
      "text": "凡出言，信为先；诈与妄，奚可焉。",
      "ref": "信"
    }
  ],
  "说文解字": [
    {
      "id": "sw-1",
      "text": "仓颉之初作书，盖依类象形，故谓之文；其后形声相益，即谓之字。",
      "ref": "叙"
    }
  ],
  "孙子兵法": [
    {
      "id": "szbf-1",
      "text": "知彼知己，百战不殆；不知彼而知己，一胜一负。",
      "ref": "谋攻"
    }
  ],
  "孟子": [
    {
      "id": "mengzi-1",
      "text": "天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为。",
      "ref": "告子下"
    },
    {
      "id": "mengzi-2",
      "text": "鱼，我所欲也；熊掌，亦我所欲也。二者不可得兼，舍鱼而取熊掌者也。",
      "ref": "告子上"
    },
    {
      "id": "mengzi-3",
      "text": "我善养吾浩然之气。",
      "ref": "公孙丑上"
    },
    {
      "id": "mengzi-4",
      "text": "民为贵，社稷次之，君为轻。",
      "ref": "尽心下"
    }
  ],
  "荀子": [
    {
      "id": "xunzi-1",
      "text": "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。",
      "ref": "劝学"
    },
    {
      "id": "xunzi-2",
      "text": "锲而舍之，朽木不折；锲而不舍，金石可镂。",
      "ref": "劝学"
    },
    {
      "id": "xunzi-3",
      "text": "人之性恶，其善者伪也。",
      "ref": "性恶"
    }
  ],
  "墨子": [
    {
      "id": "mozi-1",
      "text": "兼相爱，交相利。",
      "ref": "兼爱"
    },
    {
      "id": "mozi-2",
      "text": "今攻三里之城、七里之郭，杀人多必数万，此其为不利于人也。",
      "ref": "非攻"
    },
    {
      "id": "mozi-3",
      "text": "官无常贵，而民无终贱，有能则举之，无能则下之。",
      "ref": "尚贤"
    }
  ],
  "韩非子": [
    {
      "id": "hz-1",
      "text": "世异则事异，事异则备变。",
      "ref": "五蠹"
    },
    {
      "id": "hz-2",
      "text": "法不阿贵，绳不挠曲。",
      "ref": "有度"
    },
    {
      "id": "hz-3",
      "text": "宰相必起于州部，猛将必发于卒伍。",
      "ref": "显学"
    }
  ],
  "传习录": [
    {
      "id": "czl-1",
      "text": "知是行之始，行是知之成。",
      "ref": "传习录"
    },
    {
      "id": "czl-2",
      "text": "心即理也。天下又有心外之事、心外之理乎？",
      "ref": "传习录"
    }
  ],
  "资治通鉴": [
    {
      "id": "zztj-1",
      "text": "兼听则明，偏信则暗。",
      "ref": "唐纪·太宗"
    },
    {
      "id": "zztj-2",
      "text": "才者，德之资也；德者，才之帅也。",
      "ref": "周纪·威烈王"
    }
  ],
  "史记": [
    {
      "id": "shiji-1",
      "text": "究天人之际，通古今之变，成一家之言。",
      "ref": "太史公自序"
    },
    {
      "id": "shiji-2",
      "text": "王侯将相宁有种乎！",
      "ref": "陈涉世家"
    }
  ],
  "汉书": [
    {
      "id": "hanshu-1",
      "text": "临渊羡鱼，不如退而结网。",
      "ref": "礼乐志"
    },
    {
      "id": "hanshu-2",
      "text": "仁谊（义）礼知（智）信，五常之道，王者所当修饬也。",
      "ref": "董仲舒传"
    }
  ],
  "周礼": [
    {
      "id": "zl-1",
      "text": "惟王建国，辨方正位，体国经野，设官分职，以为民极。",
      "ref": "天官·冢宰"
    }
  ],
  "梦溪笔谈": [
    {
      "id": "mxt-1",
      "text": "方家以磁石磨针锋，则能指南，然常微偏东，不全南也。",
      "ref": "杂志一"
    }
  ],
  "春秋繁露": [
    {
      "id": "czfl-1",
      "text": "道之大原出于天，天不变，道亦不变。",
      "ref": "楚庄王"
    }
  ],
  "文心雕龙": [
    {
      "id": "wxd-1",
      "text": "文之为德也大矣，与天地并生者何哉！",
      "ref": "原道"
    },
    {
      "id": "wxd-2",
      "text": "心生而言立，言立而文明，自然之道也。",
      "ref": "原道"
    }
  ]
}